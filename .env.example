# Database — psycopg 3 async driver
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/real_estate_db

# Redis (not needed until Phase 4+)
REDIS_URL=

# JWT
SECRET_KEY=change-me-generate-with-python-secrets
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_URL=http://localhost:8000/files

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# KYC Provider
KYC_PROVIDER=
KYC_API_KEY=
KYC_WEBHOOK_SECRET=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Email
EMAIL_PROVIDER=
EMAIL_API_KEY=
